# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Commit .env.example (template). Never commit .env (secrets) — it is gitignored.

# ── Model configuration ──────────────────────────────────────────────────────
# PROVIDER: "openai" or "huggingface"
PROVIDER=huggingface

# MODEL: Hugging Face repo id or OpenAI model name
MODEL=google/gemma-2-2b-it

# MODE: "white" (local weights) or "black" (API only). OpenAI is always black.
MODE=black

# ── API keys (leave blank if not needed for your PROVIDER / MODE) ───────────
# HF_TOKEN: Hugging Face token (paste in .env or enter when prompted in the notebook)
HF_TOKEN=

# OPENAI_API_KEY: required for OpenAI provider and some claim-level UQ steps
OPENAI_API_KEY=
